// Shop template models — appended to the base schema by 04a-app-init.sh

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  imageUrl    String?
  createdAt   DateTime @default(now())

  cartItems   CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id])

  @@index([productId])
}
