// Imported models - appended to the base schema by 04a-app-init.sh

model Post {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  excerpt      String
  content      String
  coverImage   String    @default("/images/post-nextjs-arch.svg")
  category     String    @default("Engineering")
  tags         String    @default("Next.js, Architecture")
  readTime     String    @default("5 min read")
  featured     Boolean   @default(false)
  published    Boolean   @default(true)
  authorName   String    @default("Krisna Jane")
  authorRole   String    @default("Staff Engineer")
  authorAvatar String    @default("/images/author-avatar.svg")
  publishedAt  DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  comments     Comment[]

  @@index([slug])
  @@index([category])
  @@index([published])
  @@index([featured])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    String
  content   String
  createdAt DateTime @default(now())

  @@index([postId])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
